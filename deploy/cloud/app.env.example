# /opt/inkmind/app.env, deployment-user owned, chmod 600.
SITE_DOMAIN=inkmind.jastcraft.com
CORS_ORIGINS=https://inkmind.jastcraft.com
SECRET_KEY=REPLACE_WITH_EXISTING_KEY_OR_NEW_RANDOM_KEY
DATABASE_URL=sqlite:////app/data/inkmind.db
DEFAULT_LLM_PROVIDER=qwen
# Copy existing provider/model configuration here; preserve real credentials.
# Container UID/GID is 1000; /opt/inkmind/data must be writable by it.

# Optional Alipay web billing. Keep disabled until keys, catalog, terms and
# notification verification are ready. Merge into app.env without replacing
# existing credentials. Paths below are inside the existing /app/data mount.
TZ=Asia/Shanghai
BILLING_ENABLED=false
ALIPAY_SANDBOX=false
ALIPAY_APP_ID=2021007106622216
ALIPAY_SELLER_ID=2088012766025526
ALIPAY_PRIVATE_KEY_PATH=/app/data/alipay/app-private.keytext
ALIPAY_PUBLIC_KEY_PATH=/app/data/alipay/alipay-public.keytext
ALIPAY_API_BASE_URL=https://inkmind.jastcraft.com/api
ALIPAY_NOTIFY_URL=https://inkmind.jastcraft.com/api/billing/notify
ALIPAY_RETURN_URL=https://inkmind.jastcraft.com/api/billing/return
BILLING_FRONTEND_URL=https://inkmind.jastcraft.com/usage
BILLING_AGENT_PROXY_BASE_URL=http://127.0.0.1:8000/billing/agent-proxy
BILLING_TERMS_URL=https://inkmind.jastcraft.com/terms
BILLING_SUPPORT_EMAIL=zhou.zilong@qq.com
BILLING_PACKAGES=[]
BILLING_MODELS=[]
