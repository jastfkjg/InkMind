# /opt/inkmind/app.env, deployment-user owned, chmod 600.
SITE_DOMAIN=inkmind.jastcraft.com
CORS_ORIGINS=https://inkmind.jastcraft.com
SECRET_KEY=REPLACE_WITH_EXISTING_KEY_OR_NEW_RANDOM_KEY
DATABASE_URL=sqlite:////app/data/inkmind.db
DEFAULT_LLM_PROVIDER=qwen
# Copy existing provider/model configuration here; preserve real credentials.
# Container UID/GID is 1000; /opt/inkmind/data must be writable by it.
