{
  "name": "inkmind-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "InkMind local desktop writing app",
  "author": "InkMind contributors",
  "license": "GPL-3.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k -s first \"npm --prefix ../frontend run dev -- --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && INKMIND_FRONTEND_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build:main": "tsc -p tsconfig.json",
    "build:ui": "npm --prefix ../frontend run build",
    "build:backend": "./scripts/build-backend.sh",
    "build": "npm run build:main && npm run build:ui",
    "package:mac": "npm run build && npm run build:backend && electron-builder --mac dmg zip --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "concurrently": "^9.2.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "typescript": "~5.7.2",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "app.inkmind.desktop",
    "productName": "InkMind",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend",
        "filter": ["**/*"]
      },
      {
        "from": "../backend/dist/inkmind-backend",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon.png",
      "target": ["dmg", "zip"],
      "hardenedRuntime": true
    }
  }
}
